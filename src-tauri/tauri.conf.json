{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vuretro",
  "mainBinaryName": "vuretro",
  "version": "0.1.7",
  "identifier": "dev.vuvn.vuretro",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Vuretro",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 640,
        "backgroundColor": "#090B10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzMjgxNzg5NzZCRDczM0IKUldRN2M3MTJpUmNvRTd5Q3NyS010bVFKMFNTL05UeWpvUGZoMGNXUmhDdlhNVnpkVTJ6V0pCMWQK",
      "endpoints": [
        "https://github.com/vunguyenvu35/vuretro/releases/latest/download/latest.json"
      ]
    }
  }
}
